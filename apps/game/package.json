{
  "name": "@31mus/game",
  "version": "0.0.0",
  "private": true,
  "description": "Servidor de juego en tiempo real (Colyseus desde H3).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "play": "tsx --env-file-if-exists=../../.env src/cli/play.ts",
    "play:script": "tsx --env-file-if-exists=../../.env src/cli/play-script.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@31mus/bots": "workspace:*",
    "@31mus/engine": "workspace:*",
    "@31mus/shared": "workspace:*",
    "@colyseus/core": "0.18.29",
    "@colyseus/schema": "5.0.50",
    "@colyseus/ws-transport": "0.18.5",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@31mus/config": "workspace:*",
    "@colyseus/sdk": "0.18.10",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.11",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}

# 1) gitleaks: bloquea secretos en los cambios preparados (CLAUDE.md §11).
#    Si falta, el commit NO se permite: no se salta en silencio.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "✖ gitleaks no está instalado. Instálalo con: winget install --id Gitleaks.Gitleaks" >&2
  echo "  y abre una terminal nueva antes de volver a hacer commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner --verbose

# 2) lint-staged: ESLint + Prettier sobre los archivos preparados.
pnpm exec lint-staged

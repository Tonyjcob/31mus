# ------------------------------------------------------------------
# 31mus — variables de entorno de DESARROLLO.
# Copia este archivo a `.env` (que nunca se versiona) y cambia los valores:
#   PowerShell:  Copy-Item .env.example .env
# Todos los valores de aquí son ficticios.
# ------------------------------------------------------------------

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=mus
POSTGRES_PASSWORD=cambia-esto-en-tu-env
POSTGRES_DB=mus_dev
# Puerto publicado solo en 127.0.0.1
POSTGRES_PORT=5432

# Cadena de conexión que usarán api y game (Prisma, desde H6).
# IMPORTANTE: si cambias POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_PORT o POSTGRES_DB,
# actualiza también esta URL (Node no expande variables dentro del .env).
DATABASE_URL=postgresql://mus:cambia-esto-en-tu-env@localhost:5432/mus_dev

# --- Redis (docker-compose.yml) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Puertos de las apps ---
WEB_PORT=5173
API_PORT=3000
GAME_PORT=2567

# --- Servidor de juego (apps/game) ---
# development | test | production. En production se rechaza la identidad de desarrollo (ADR-0004 §3).
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
